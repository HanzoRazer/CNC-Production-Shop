{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://texasguitarexchange.dev/schemas/instrument-profile-v1.schema.json",
  "title": "Instrument Profile v1",
  "description": "External contract for a Musical Spatial Mapping Engine instrument profile. Structural validation only; runtime semantic validation (validation.py) remains required.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "instrument_id",
    "display_name",
    "family",
    "fingerboard_mode",
    "strings",
    "scale_length_mm",
    "fret_count",
    "reference_markers",
    "metadata"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "instrument_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "fingerboard_mode": { "enum": ["fretted", "fretless", "hybrid"] },
    "scale_length_mm": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "fret_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "string_id",
          "display_label",
          "display_order",
          "open_midi_note"
        ],
        "properties": {
          "string_id": { "type": "string", "minLength": 1 },
          "display_label": { "type": "string" },
          "display_order": { "type": "integer" },
          "open_midi_note": { "type": "integer", "minimum": 0, "maximum": 127 },
          "course_id": { "type": ["string", "null"] },
          "enabled": { "type": "boolean" },
          "max_position": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "reference_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["marker_id", "semitone_offset", "label"],
        "properties": {
          "marker_id": { "type": "string", "minLength": 1 },
          "semitone_offset": { "type": "number", "minimum": 0 },
          "label": { "type": "string" }
        }
      }
    },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "fingerboard_mode": { "const": "fretted" } } },
      "then": { "properties": { "fret_count": { "type": "integer", "minimum": 1 } } }
    },
    {
      "if": { "properties": { "fingerboard_mode": { "const": "fretless" } } },
      "then": { "properties": { "fret_count": { "type": "null" } } }
    }
  ]
}
