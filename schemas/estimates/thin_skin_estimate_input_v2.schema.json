{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thin_skin_estimate_input_v2.schema.json",
  "title": "ThinSkinEstimateInputV2",
  "description": "Governed input record for an internal thin-skin laminated-body guitar manufacturing estimate. Carries no customer price, margin, overhead allocation, warranty reserve, or fulfilment cost. Supersedes guitar_estimate_input_v1 for the laminated architecture; V1 remains valid for the solid-body comparison variant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estimate_input_id",
    "product_id",
    "product_ref",
    "variant_id",
    "variant_description",
    "status",
    "quantity",
    "currency",
    "material_inputs",
    "purchased_component_inputs",
    "labor_rate_inputs",
    "operations",
    "machine_profile_ref",
    "cost_basis_ref",
    "machine_id",
    "cost_basis_id",
    "equipment_refs",
    "material_scrap_policy",
    "process_yield_reserve_policy",
    "provenance",
    "notes"
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "confidence"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "vendor_quote",
            "catalog_price",
            "owner_confirmed",
            "inherited_shop_default",
            "engineering_estimate",
            "measured_trial",
            "calculated"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "approved"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "inputCategory": {
      "type": "string",
      "enum": [
        "core_material",
        "skin_material",
        "adhesive_lamination",
        "neck_fretboard",
        "hardware",
        "electronics",
        "finish_material",
        "other_consumables"
      ]
    },
    "inputLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "description",
        "category",
        "quantity",
        "unit",
        "unit_cost",
        "provenance"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/inputCategory"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "unit_cost": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  },
  "properties": {
    "estimate_input_id": {
      "type": "string",
      "pattern": "^THIN-SKIN-ESTIMATE-INPUT-[A-Z0-9-]+$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^PRODUCT-[A-Z0-9-]+$"
    },
    "product_ref": {
      "type": "string",
      "minLength": 1
    },
    "variant_id": {
      "type": "string",
      "pattern": "^VARIANT-[A-Z0-9-]+$"
    },
    "variant_description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "superseded",
        "retired"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "minLength": 3
    },
    "material_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inputLine"
      }
    },
    "purchased_component_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputLine"
      }
    },
    "labor_rate_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "labor_rate_id",
          "description",
          "base_wage_per_hour",
          "payroll_burden_pct",
          "loaded_rate_per_hour",
          "provenance"
        ],
        "properties": {
          "labor_rate_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "base_wage_per_hour": {
            "type": "number",
            "minimum": 0
          },
          "payroll_burden_pct": {
            "type": "number",
            "minimum": 0
          },
          "loaded_rate_per_hour": {
            "type": "number",
            "minimum": 0,
            "description": "Draft internal direct-labor cost. Never a burdened commercial shop rate."
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "wbs_code",
          "description",
          "labor_category",
          "attendance",
          "time_model",
          "uses_machine",
          "equipment_id",
          "reserve_eligible",
          "labor_rate_id",
          "provenance"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "wbs_code": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "labor_category": {
            "type": "string",
            "enum": [
              "lamination_labor",
              "direct_build_labor",
              "finishing_labor",
              "assembly_labor",
              "setup_and_inspection"
            ]
          },
          "attendance": {
            "type": "string",
            "enum": [
              "attended",
              "partially_attended",
              "unattended",
              "queue_or_cure"
            ]
          },
          "time_model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "setup_minutes",
              "operator_touch_minutes",
              "machine_runtime_minutes",
              "equipment_occupancy_minutes",
              "elapsed_wait_minutes",
              "rework_minutes"
            ],
            "description": "Six-field time model. Labor is setup + operator_touch + rework only. Machine runtime, equipment occupancy, and elapsed wait are never labor. setup_scope decides whether setup amortises across a run; it is optional and defaults to per_unit.",
            "properties": {
              "setup_minutes": {
                "type": "number",
                "minimum": 0
              },
              "operator_touch_minutes": {
                "type": "number",
                "minimum": 0
              },
              "machine_runtime_minutes": {
                "type": "number",
                "minimum": 0
              },
              "equipment_occupancy_minutes": {
                "type": "number",
                "minimum": 0
              },
              "elapsed_wait_minutes": {
                "type": "number",
                "minimum": 0
              },
              "rework_minutes": {
                "type": "number",
                "minimum": 0
              },
              "setup_scope": {
                "enum": [
                  "per_unit",
                  "per_batch"
                ],
                "description": "Whether setup recurs per unit or once per run. OPTIONAL: omitted means per_unit, which is what every record written before this field existed assumed. Only per_batch is amortisable, and at quantity one the two are identical."
              }
            }
          },
          "uses_machine": {
            "type": "boolean"
          },
          "equipment_id": {
            "type": "string",
            "pattern": "^(EQUIPMENT-[A-Z0-9-]+)?$"
          },
          "reserve_eligible": {
            "type": "boolean"
          },
          "labor_rate_id": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    },
    "machine_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "cost_basis_ref": {
      "type": "string",
      "minLength": 1
    },
    "machine_id": {
      "type": "string",
      "pattern": "^MACHINE-[A-Z0-9-]+$"
    },
    "cost_basis_id": {
      "type": "string",
      "pattern": "^MACHINE-COST-BASIS-[A-Z0-9-]+$"
    },
    "equipment_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "equipment_id",
          "equipment_profile_ref",
          "cost_basis_ref",
          "cost_basis_id"
        ],
        "properties": {
          "equipment_id": {
            "type": "string",
            "pattern": "^EQUIPMENT-[A-Z0-9-]+$"
          },
          "equipment_profile_ref": {
            "type": "string",
            "minLength": 1
          },
          "cost_basis_ref": {
            "type": "string",
            "minLength": 1
          },
          "cost_basis_id": {
            "type": "string",
            "pattern": "^EQUIPMENT-COST-BASIS-[A-Z0-9-]+$"
          }
        }
      }
    },
    "material_scrap_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scrap_rate",
        "eligible_input_ids",
        "provenance"
      ],
      "description": "Narrow allowance on stock material only. Distinct from, and never compounded with, the process yield reserve.",
      "properties": {
        "scrap_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eligible_input_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "process_yield_reserve_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserve_rate",
        "eligible_input_ids",
        "include_machine_time",
        "include_equipment_occupancy",
        "provenance"
      ],
      "description": "Broader reserve on eligible conversion cost. Labor eligibility is carried per operation by reserve_eligible, not by a category sweep.",
      "properties": {
        "reserve_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eligible_input_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "include_machine_time": {
          "type": "boolean"
        },
        "include_equipment_occupancy": {
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
