{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guitar_build_estimate_v1.schema.json",
  "title": "GuitarBuildEstimateV1",
  "description": "Calculated internal manufacturing estimate for one CNC electric guitar. No customer price, markup, or margin fields are permitted.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "money": {"type": "number", "minimum": 0},
    "repo_relative_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*\\.\\.).+$"
    },
    "input_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "confidence"],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "vendor_quote",
            "catalog_price",
            "owner_confirmed",
            "inherited_shop_default",
            "engineering_estimate",
            "measured_trial",
            "calculated"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved"]
        },
        "note": {"type": "string"}
      }
    }
  },
  "required": [
    "estimate_id",
    "product_id",
    "product_ref",
    "estimate_input_id",
    "estimate_input_ref",
    "status",
    "quantity",
    "currency",
    "cost_summary",
    "operation_results",
    "machine_costing",
    "calculation",
    "provenance",
    "notes"
  ],
  "properties": {
    "estimate_id": {
      "type": "string",
      "pattern": "^GUITAR-BUILD-ESTIMATE-[A-Z0-9-]+$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^PRODUCT-[A-Z0-9-]+$"
    },
    "product_ref": {"$ref": "#/$defs/repo_relative_ref"},
    "estimate_input_id": {
      "type": "string",
      "pattern": "^GUITAR-ESTIMATE-INPUT-[A-Z0-9-]+$"
    },
    "estimate_input_ref": {"$ref": "#/$defs/repo_relative_ref"},
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "approved", "superseded", "retired"]
    },
    "quantity": {"type": "integer", "minimum": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "cost_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wood_material_cost",
        "hardware_cost",
        "electronics_cost",
        "consumables_cost",
        "machine_time_cost",
        "direct_labor_cost",
        "finishing_cost",
        "inspection_and_setup_cost",
        "scrap_allowance",
        "total_direct_manufacturing_cost"
      ],
      "properties": {
        "wood_material_cost": {"$ref": "#/$defs/money"},
        "hardware_cost": {"$ref": "#/$defs/money"},
        "electronics_cost": {"$ref": "#/$defs/money"},
        "consumables_cost": {"$ref": "#/$defs/money"},
        "machine_time_cost": {"$ref": "#/$defs/money"},
        "direct_labor_cost": {"$ref": "#/$defs/money"},
        "finishing_cost": {"$ref": "#/$defs/money"},
        "inspection_and_setup_cost": {"$ref": "#/$defs/money"},
        "scrap_allowance": {"$ref": "#/$defs/money"},
        "total_direct_manufacturing_cost": {"$ref": "#/$defs/money"}
      }
    },
    "operation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "wbs_code",
          "cost_category",
          "machine_minutes",
          "labor_minutes",
          "cure_or_wait_minutes",
          "machine_time_cost",
          "labor_cost",
          "category_cost"
        ],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "wbs_code": {"type": "string", "minLength": 1},
          "cost_category": {
            "type": "string",
            "enum": [
              "machine",
              "direct_labor",
              "finishing",
              "inspection_and_setup"
            ]
          },
          "machine_minutes": {"type": "number", "minimum": 0},
          "labor_minutes": {"type": "number", "minimum": 0},
          "cure_or_wait_minutes": {"type": "number", "minimum": 0},
          "machine_time_cost": {"$ref": "#/$defs/money"},
          "labor_cost": {"$ref": "#/$defs/money"},
          "category_cost": {"$ref": "#/$defs/money"}
        }
      }
    },
    "machine_costing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_id",
        "machine_profile_ref",
        "cost_basis_id",
        "cost_basis_ref",
        "cost_basis_role",
        "runtime_minutes",
        "machine_hour_rate",
        "derived_machine_time_cost",
        "derivation",
        "provenance_status"
      ],
      "properties": {
        "machine_id": {
          "type": "string",
          "pattern": "^MACHINE-[A-Z0-9-]+$"
        },
        "machine_profile_ref": {"$ref": "#/$defs/repo_relative_ref"},
        "cost_basis_id": {
          "type": "string",
          "pattern": "^MACHINE-COST-BASIS-[A-Z0-9-]+$"
        },
        "cost_basis_ref": {"$ref": "#/$defs/repo_relative_ref"},
        "cost_basis_role": {
          "type": "string",
          "enum": ["internal_technical_cost"]
        },
        "runtime_minutes": {"type": "number", "exclusiveMinimum": 0},
        "machine_hour_rate": {"$ref": "#/$defs/money"},
        "derived_machine_time_cost": {"$ref": "#/$defs/money"},
        "derivation": {"type": "string", "minLength": 1},
        "provenance_status": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved", "superseded", "retired"]
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calculator_id",
        "rounding_policy",
        "effective_date"
      ],
      "properties": {
        "calculator_id": {
          "type": "string",
          "const": "guitar_build_estimate_v1"
        },
        "rounding_policy": {
          "type": "string",
          "const": "currency_half_up_2dp"
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "provenance": {"$ref": "#/$defs/input_provenance"},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
