{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thin_skin_guitar_product_definition_v1.schema.json",
  "title": "ThinSkinGuitarProductDefinitionV1",
  "description": "Neutral physical product definition for a laminated thin-skin electric guitar body architecture. Core and skin species are deliberately NOT product invariants: they are governed estimate inputs so that competing architectures can be compared under one product identity. Contains no cost, price, margin, or commercial rate fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_id",
    "product_name",
    "status",
    "construction",
    "body_architecture",
    "materials",
    "configuration",
    "provenance",
    "notes"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^PRODUCT-[A-Z0-9-]+$",
      "minLength": 1
    },
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "product_description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "approved", "superseded", "retired"]
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_type",
        "neck_joint",
        "neck_sourcing",
        "scale_length_in",
        "string_count",
        "orientation"
      ],
      "properties": {
        "body_type": {
          "type": "string",
          "enum": ["laminated_thin_skin", "solid_body", "chambered"]
        },
        "neck_joint": {
          "type": "string",
          "enum": ["bolt_on"]
        },
        "neck_sourcing": {
          "type": "string",
          "enum": ["shop_machined", "purchased_complete"]
        },
        "scale_length_in": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "string_count": {
          "type": "integer",
          "minimum": 1
        },
        "orientation": {
          "type": "string",
          "enum": ["right_handed", "left_handed"]
        }
      }
    },
    "body_architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_role",
        "skin_role",
        "bonding_process",
        "indexing_method",
        "nominal_core_thickness_in",
        "nominal_skin_thickness_in"
      ],
      "properties": {
        "core_role": {"type": "string", "minLength": 1},
        "skin_role": {"type": "string", "minLength": 1},
        "bonding_process": {"type": "string", "minLength": 1},
        "indexing_method": {"type": "string", "minLength": 1},
        "nominal_core_thickness_in": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nominal_skin_thickness_in": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "chambered": {"type": "boolean"}
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_family", "skin_family", "neck", "fingerboard"],
      "properties": {
        "core_family": {
          "type": "string",
          "minLength": 1,
          "description": "Material FAMILY only. The specific core species is a governed estimate input, not a product invariant."
        },
        "skin_family": {"type": "string", "minLength": 1},
        "neck": {"type": "string", "minLength": 1},
        "fingerboard": {"type": "string", "minLength": 1}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pickup_layout",
        "bridge_type",
        "control_layout",
        "finish_system",
        "electronics_sourcing"
      ],
      "properties": {
        "pickup_layout": {"type": "string", "minLength": 1},
        "bridge_type": {"type": "string", "minLength": 1},
        "control_layout": {"type": "string", "minLength": 1},
        "finish_system": {"type": "string", "minLength": 1},
        "electronics_sourcing": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "confidence"],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "vendor_quote",
            "catalog_price",
            "owner_confirmed",
            "inherited_shop_default",
            "engineering_estimate",
            "measured_trial",
            "calculated"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved"]
        },
        "captured_by": {"type": "string"},
        "capture_date": {"type": "string"},
        "references": {
          "type": "array",
          "items": {"type": "string"}
        },
        "note": {"type": "string"}
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
