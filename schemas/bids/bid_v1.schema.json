{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bid_v1.schema.json",
  "title": "BidV1",
  "description": "Internal bid calculation record with cost basis, risk factors, and margin pricing",
  "type": "object",
  "required": [
    "bid_id",
    "project_name",
    "customer_name",
    "revision",
    "status",
    "created_at",
    "updated_at",
    "assumptions",
    "line_items",
    "cost_basis",
    "pricing",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "bid_id": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "customer_name": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "approved", "sent", "superseded", "rejected"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_ref": {
      "type": ["string", "null"]
    },
    "manufacturing_ref": {
      "type": ["string", "null"]
    },
    "scenario_ref": {
      "type": ["string", "null"]
    },
    "machine_costing": {
      "type": "object",
      "description": "Optional opt-in link from a bid to a governed machine cost basis. When present, cost_basis.machine_time_cost must equal derived_machine_time_cost (machine_hour_rate * runtime_minutes / 60). Absent on legacy bids, which keep hand-entered machine_time_cost unchanged. The machine_hour_rate is an internal technical cost basis, not a commercial billing rate.",
      "additionalProperties": false,
      "required": [
        "machine_id",
        "machine_profile_ref",
        "cost_basis_id",
        "cost_basis_ref",
        "cost_basis_role",
        "runtime_minutes",
        "machine_hour_rate",
        "derived_machine_time_cost",
        "derivation",
        "provenance_status"
      ],
      "properties": {
        "machine_id": {
          "type": "string",
          "pattern": "^MACHINE-[A-Z0-9-]+$",
          "description": "Machine profile identifier used for this derivation"
        },
        "machine_profile_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*\\.\\.).+$",
          "description": "Repository-relative path to the machine profile fixture (no absolute paths, no '..')"
        },
        "cost_basis_id": {
          "type": "string",
          "pattern": "^MACHINE-COST-BASIS-[A-Z0-9-]+$",
          "description": "Cost-basis record identifier used for this derivation"
        },
        "cost_basis_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*\\.\\.).+$",
          "description": "Repository-relative path to the machine cost-basis fixture (no absolute paths, no '..')"
        },
        "cost_basis_role": {
          "type": "string",
          "enum": ["internal_technical_cost"],
          "description": "Labels the rate as internal technical cost, not a commercial billing rate"
        },
        "runtime_minutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Machine runtime for the job, in minutes"
        },
        "machine_hour_rate": {
          "type": "number",
          "minimum": 0,
          "description": "Internal technical machine-hour cost from the governed cost basis"
        },
        "derived_machine_time_cost": {
          "type": "number",
          "minimum": 0,
          "description": "machine_hour_rate * runtime_minutes / 60, rounded per shop money convention"
        },
        "derivation": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable derivation formula preserved with the bid"
        },
        "provenance_status": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved", "superseded", "retired"],
          "description": "Must not overstate the referenced cost-basis record status"
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "value", "source", "confidence"],
        "additionalProperties": false,
        "properties": {
          "field": {"type": "string"},
          "value": {},
          "source": {"type": "string"},
          "confidence": {
            "type": "string",
            "enum": ["draft", "reviewed", "approved", "superseded", "unknown"]
          },
          "note": {"type": "string"}
        }
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "quantity", "unit", "unit_cost", "total_cost"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "category": {"type": "string"},
          "quantity": {"type": "number", "minimum": 0},
          "unit": {"type": "string"},
          "unit_cost": {"type": "number", "minimum": 0},
          "total_cost": {"type": "number", "minimum": 0},
          "note": {"type": "string"}
        }
      }
    },
    "cost_basis": {
      "type": "object",
      "required": [
        "direct_material_cost",
        "direct_labor_cost",
        "machine_time_cost",
        "tooling_cost",
        "setup_cost",
        "finishing_cost",
        "finishing_material_cost",
        "engineering_cost",
        "base_manufacturing_cost"
      ],
      "additionalProperties": false,
      "properties": {
        "direct_material_cost": {"type": "number", "minimum": 0},
        "direct_labor_cost": {"type": "number", "minimum": 0},
        "machine_time_cost": {"type": "number", "minimum": 0},
        "tooling_cost": {"type": "number", "minimum": 0},
        "setup_cost": {"type": "number", "minimum": 0},
        "finishing_cost": {"type": "number", "minimum": 0},
        "finishing_material_cost": {"type": "number", "minimum": 0},
        "engineering_cost": {"type": "number", "minimum": 0},
        "base_manufacturing_cost": {"type": "number", "minimum": 0}
      }
    },
    "pricing": {
      "type": "object",
      "required": [
        "tool_wear_pct",
        "manufacturing_contingency_pct",
        "business_overhead_pct",
        "engineering_recovery_pct",
        "target_margin_pct",
        "risked_cost",
        "quote_price",
        "quantity",
        "price_per_unit"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_wear_pct": {"type": "number", "minimum": 0},
        "manufacturing_contingency_pct": {"type": "number", "minimum": 0},
        "business_overhead_pct": {"type": "number", "minimum": 0},
        "engineering_recovery_pct": {"type": "number", "minimum": 0},
        "target_margin_pct": {"type": "number", "minimum": 0, "exclusiveMaximum": 100},
        "risked_cost": {"type": "number", "minimum": 0},
        "quote_price": {"type": "number", "minimum": 0},
        "quantity": {"type": "integer", "minimum": 1},
        "price_per_unit": {"type": "number", "minimum": 0}
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
