{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job_quote_price_review_request_v1.schema.json",
  "title": "CncJobQuotePriceReviewRequestV1",
  "description": "Caller-asserted request to record a human price decision against one retained manifest digest. Passing this schema does not authenticate the reviewer, approve a price, authorize sending a proposal, or release manufacturing. The decision approve_price records what the caller says a human decided; it is not an approval gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "record_version",
    "review_id",
    "reviewed_at",
    "reviewer_ref",
    "reviewer_role",
    "decision",
    "reason",
    "internal_notes",
    "expected_manifest_sha256",
    "reviewed_subject",
    "cost_basis_acknowledgment"
  ],
  "properties": {
    "record_type": {"const": "cnc_job_quote_price_review_request"},
    "record_version": {"const": "1.0.0"},
    "review_id": {"$ref": "#/$defs/identifier"},
    "reviewed_at": {"$ref": "#/$defs/canonical_utc"},
    "reviewer_ref": {"$ref": "#/$defs/nonblank"},
    "reviewer_role": {"$ref": "#/$defs/nonblank"},
    "decision": {"enum": ["approve_price", "request_changes", "reject"]},
    "reason": {"$ref": "#/$defs/nonblank"},
    "internal_notes": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonblank"}
    },
    "expected_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reviewed_subject": {"$ref": "#/$defs/reviewed_subject"},
    "cost_basis_acknowledgment": {"const": "direct_manufacturing_cost_only"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nonblank": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S).+$"
    },
    "canonical_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewed_subject": {
      "type": "object",
      "additionalProperties": false,
      "description": "The subject the human says they reviewed. Recording compares these fields with the captured packet. It does not reprice the packet.",
      "required": [
        "job_id",
        "estimate_id",
        "bid_id",
        "proposal_id",
        "revision",
        "currency",
        "quantity",
        "quote_price"
      ],
      "properties": {
        "job_id": {"$ref": "#/$defs/nonblank"},
        "estimate_id": {"$ref": "#/$defs/nonblank"},
        "bid_id": {"$ref": "#/$defs/nonblank"},
        "proposal_id": {"$ref": "#/$defs/nonblank"},
        "revision": {"$ref": "#/$defs/nonblank"},
        "currency": {"const": "USD"},
        "quantity": {"type": "integer", "const": 1},
        "quote_price": {"type": "number", "minimum": 0}
      }
    }
  }
}
