{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnc-production-shop/schemas/releases/release_manifest_v1.schema.json",
  "title": "ReleaseManifestV1",
  "description": "Governed evidence record for a cnc-production-shop release candidate or release. Synthetic fixtures must not be treated as production releases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "distribution_name",
    "distribution_version",
    "release_state",
    "commit_sha",
    "tag",
    "created_at",
    "python_versions",
    "artifacts",
    "test_summary",
    "ci_summary",
    "subsystem_versions",
    "notes_ref",
    "example_only"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^REL-CNC-[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "REL-CNC-<VERSION>"
    },
    "distribution_name": {
      "const": "cnc-production-shop"
    },
    "distribution_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "release_state": {
      "type": "string",
      "enum": ["development", "release_candidate", "released", "withdrawn"]
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tag": {
      "type": "string",
      "description": "Canonical vMAJOR.MINOR.PATCH, or empty when no distribution tag exists yet."
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "python_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^3\\.(11|12)$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "sha256"],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "test_summary": {
      "type": "string",
      "minLength": 1
    },
    "ci_summary": {
      "type": "string",
      "minLength": 1
    },
    "subsystem_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["MSME_API_VERSION"],
      "properties": {
        "MSME_API_VERSION": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notes_ref": {
      "type": "string",
      "minLength": 1
    },
    "example_only": {
      "type": "boolean",
      "description": "True for synthetic fixtures that must not be treated as production releases."
    }
  }
}
